ADMIN_PASSWORD=
SOCIAL_GATEWAY_UPSTREAM_BASE_URL=https://media.example.com/v1
SOCIAL_GATEWAY_UPSTREAM_RESPONSES_PATH=/responses

# grok2api v3：在 /client-keys 创建 g2a_ key 后填到 UPSTREAM_API_KEY。
SOCIAL_GATEWAY_UPSTREAM_API_KEY=
SOCIAL_GATEWAY_MODEL=grok-4.20-0309
SOCIAL_GATEWAY_FALLBACK_MODEL=grok-4.3
SOCIAL_GATEWAY_TOKEN=

# 可选：grok2api v3 管理统计。管理员会话不能代替上面的 g2a_ client key。
SOCIAL_GATEWAY_ADMIN_BASE_URL=https://media.example.com
SOCIAL_GATEWAY_ADMIN_USERNAME=
SOCIAL_GATEWAY_ADMIN_PASSWORD=

# 仅用于 grok2api v2-compatible 部署的旧 admin auto 接口。
SOCIAL_GATEWAY_ADMIN_APP_KEY=
SOCIAL_GATEWAY_ADMIN_VERIFY_PATH=/v1/admin/verify
SOCIAL_GATEWAY_ADMIN_CONFIG_PATH=/admin/api/config
SOCIAL_GATEWAY_ADMIN_TOKENS_PATH=/admin/api/tokens
SOCIAL_GATEWAY_CACHE_TTL_SECONDS=60

# SOCIAL_GATEWAY_TOKEN 可选；MySearch Proxy 签发的 mysp- token 也可调用 /social/search。

# 可选：如果 Tavily 上游是 tavily-hikari，且你希望控制台继续读取上游 key / quota 细项，
# 可以额外提供 admin 访问方式。否则控制台只读取公开的 /api/summary。
# TAVILY_UPSTREAM_ADMIN_BASE_URL=https://tavily.example.com
# TAVILY_UPSTREAM_ADMIN_HEADERS={"X-Forwarded-User":"admin@example.com","X-Forwarded-Admin":"true"}
# TAVILY_UPSTREAM_ADMIN_COOKIE=
