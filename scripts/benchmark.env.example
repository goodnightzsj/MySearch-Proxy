# Benchmark runner 本地配置示例
#
# 用法：复制为 scripts/benchmark.env（该文件已被 .gitignore 忽略），
# 填入你自己的目标主机与 MCP 地址，然后：
#
#   set -a; . scripts/benchmark.env; set +a
#   python scripts/run_remote_mcp_benchmark.py
#
# 所有变量都有 CLI 参数覆盖（--host / --mysearch-url / --tavily-url），
# 此处只是为默认值提供来源。

# SSH 目标（user@host）。runner 通过它读取远端 MCP 与容器状态。
# 下面是文档用示例值（RFC 1918 私有段），请替换为你自己的目标。
MYSEARCH_BENCHMARK_HOST=root@172.16.0.10

# MySearch MCP 端点（从 runner 所在机器可达的地址）。
MYSEARCH_BENCHMARK_MYSEARCH_URL=http://127.0.0.1:18000/mcp

# Tavily 对照 MCP 端点。
MYSEARCH_BENCHMARK_TAVILY_URL=http://127.0.0.1:8787/mcp

# Tavily 对照的 Bearer token。留空时会回退到本机 ~/.codex/config.toml 里的
# mcp_servers.tavily-hikari.headers.Authorization。
MYSEARCH_BENCHMARK_TAVILY_BEARER=
